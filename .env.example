NODE_ENV=production
BASE_URL=https://your-app.onrender.com
SERVER_PORT=10000

APP_NAME=BTS_APP_BACKEND
APP_VERSION=1.1

API_BASE=/api/v1
DEFAULT_TIMEZONE=Africa/Cameroon

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=86400
JWT_EMAIL_SECRET=your_jwt_email_secret_here
JWT_EMAIL_EXPIRE=300

# Connexion Supabase PostgreSQL (onglet "Connection string" > "Session mode")
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_password
DB_AUTH=true

LOG_FILE_NAME=app-%DATE%.log
LOG_FILE_DIR=./log

MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_password

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password
ADMIN_PHONE=699999999
ADMIN_NAME=Admin Name

SENDGRID_API_KEY=SG.your_sendgrid_key
MAIL_FROM=your_email@gmail.com

WEB_APP_URL=https://your-frontend.com
RESET_PASSWORD_PATH=reset-password
CONFIRM_ACCOUNT_PATH=confirm-account

UPLOAD_DOCUMENT_USER_PATH=./public/uploads/documents_user
UPLOAD_DOCUMENT_ADMIN_PATH=./public/uploads/documents_admin
UPLOAD_PAYMENT_METHOD_PATH=./public/uploads/payment_method
UPLOAD_COVER_COURSE_PATH=./public/uploads/cover_course
UPLOAD_LESSON_VIDEO_PATH=./public/uploads/lessons_video
UPLOAD_DEFAULT_PATH=./public/uploads/others
UPLOAD_INSTITUTION_LOGO_PATH=./public/uploads/institutions_logo

# Supabase Storage (fichiers uploadés) — Project Settings > API
# Le disque de Render est éphémère : sans ces variables, les fichiers uploadés
# sont perdus à chaque redéploiement. Le bucket public est créé automatiquement.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=uploads
